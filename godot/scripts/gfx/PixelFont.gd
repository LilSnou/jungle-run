## Ширина строки с учётом межсимвольного интервала.
static func measure(text: String, scale := 1) -> float:
	return text.length() * float(GLYPH_W + TRACKING) * scale


## Нарисовать текст на канвасе (как fillRect в веб-версии).
## opts: scale (1), color ("#ffffff"), shadow (null), align ("left"/"center").
static func draw(canvas: CanvasItem, text: String, x: float, y: float, opts: Dictionary = {}) -> void:
	var scale: int = opts.get("scale", 1)
	var color = opts.get("color", "#ffffff")  # String "#rrggbb" либо Color
	var align: String = opts.get("align", "left")
	var px := roundf(x)
	var py := roundf(y)
	if align == "center":
		px = x - measure(text, scale) / 2.0
	if opts.has("shadow") and opts.shadow != null:
		draw(canvas, text, px + scale, py + scale, {
			"scale": scale, "color": opts.shadow, "align": "left",
		})
	var col: Color = color if color is Color else Color.html(color)
	for ch in text:
		var glyph: Array = DATA.get(ch, DATA.get(ch.to_upper(), DATA["?"]))
		for r in GLYPH_H:
			var row: String = glyph[r]
			var run_start := -1
			var c := 0
			while c <= GLYPH_W:
				var on := c < GLYPH_W and row[c] == "1"
				if on and run_start < 0:
					run_start = c
				if not on and run_start >= 0:
					canvas.draw_rect(Rect2(px + run_start * scale, py + r * scale,
						(c - run_start) * scale, scale), col)
					run_start = -1
				c += 1
		px += (GLYPH_W + TRACKING) * scale
